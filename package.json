{
  "name": "shinatal-tooling",
  "private": true,
  "author": "Pedro Provadelli (https://github.com/Provadelli)",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "sharp": "^0.35.4",
    "tailwindcss": "3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run layout && npm run build:css && tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:css": "tailwindcss -i ./frontend/css/tailwind-input.css -o ./frontend/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./frontend/css/tailwind-input.css -o ./frontend/css/tailwind.css --watch",
    "postinstall": "npm run build:css",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:video": "node scripts/otimizar-video.mjs",
    "icones": "node scripts/fonte-icones.mjs",
    "config:firebase": "node scripts/codificar-config-firebase.mjs",
    "layout": "node scripts/layout.mjs",
    "test:calculo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test backend/tests/calculo/regua.test.mjs backend/tests/calculo/contratos.test.mjs backend/tests/calculo/migracao.test.mjs backend/tests/calculo/planilha.test.mjs backend/tests/calculo/avaliacao.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  }
}
