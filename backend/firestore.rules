rules_version = '2';

// Shinatal — Firestore Security Rules
// Estas regras são a verdadeira camada de segurança do sistema: o cliente (navegador)
// nunca decide sozinho o que pode ler/escrever, o Firestore recusa qualquer operação que
// fuja destas regras, mesmo que alguém manipule o JavaScript da página ou a aba Network.

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function papel() {
      return estaLogado() ? perfil().role : null;
    }

    // Presidente: acima do Admin — única conta que grava contratos empresariais/avaliações
    // direto, sem passar pela fila de solicitações (ver `solicitacoes/{id}` abaixo).
    function ehPresidente() { return papel() == 'presidente'; }
    function ehAdminOuPresidente() { return papel() in ['admin', 'presidente']; }
    // "Equipe" ampla (qualquer papel de gestão) — usada em leituras compartilhadas (diretório,
    // agregados) que não implicam poder de escrita.
    function ehDpRhAdmin() { return papel() in ['dp', 'rh', 'admin', 'presidente']; }
    // Dono de faltas/atrasos/advertências (DP assumiu advertências nesta revisão).
    function ehDp() { return papel() in ['dp', 'admin', 'presidente']; }
    // Quem participa de avaliação de desempenho (DP e RH dividem esse tópico).
    function podeAvaliar() { return papel() in ['dp', 'rh', 'admin', 'presidente']; }
    // Quem pode ativar/encerrar o contrato individual do colaborador (dado interno de RH —
    // não é mais a Seção 2 do regulamento, não passa pela fila do Presidente).
    function podeGerenciarContratoColaborador() { return papel() in ['rh', 'admin', 'presidente']; }

    // Avaliação de Conduta (entre colegas) — feature social/anônima, ver seção dedicada mais
    // abaixo. Todo mundo participa (vota e é votado), MENOS o Presidente.
    function podeParticiparConduta() { return estaLogado() && papel() != 'presidente'; }
    // Checa o papel de um uid arbitrário (não o do requisitante) — usado para garantir que o
    // ALVO de um voto/presença de conduta também não seja o Presidente.
    function ehPresidenteUid(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.role == 'presidente';
    }
    // Estado do interruptor global da Avaliação de Conduta (Admin/Presidente). Se o doc nunca
    // foi criado, get() falha e a regra nega por padrão — a função nasce desligada até alguém
    // explicitamente ligá-la.
    function avaliacaoCondutaAtiva() {
      return get(/databases/$(database)/documents/configuracoes/avaliacaoConduta).data.ativo == true;
    }

    // E-mail institucional (defesa em profundidade — o token do Firebase Auth não pode ser
    // falsificado pelo cliente, ao contrário de uma checagem só em JavaScript).
    function emailInstitucional() {
      return estaLogado() && request.auth.token.email.matches('.*@shinerio[.]com$');
    }

    // E-mail confirmado (link de verificação clicado). É o que separa "conta que existe no Auth"
    // de "colaborador que existe no sistema": usuarios/{uid} só pode ser criado, lido ou editado
    // com o e-mail confirmado (ver seção abaixo) — quem se cadastra com um e-mail inexistente
    // nunca clica no link, então nunca vira um perfil (não aparece em painel, diretório, fundo).
    function emailVerificado() {
      return estaLogado() && request.auth.token.email_verified == true;
    }

    // Dados do cadastro em espera (cadastrosPendentes/{uid}) — a fonte do perfil que será criado
    // quando o e-mail for confirmado.
    function cadastroPendente(uid) {
      return get(/databases/$(database)/documents/cadastrosPendentes/$(uid)).data;
    }

    // O perfil que está sendo criado tem que ser IDÊNTICO ao cadastro pendente (que já passou por
    // cadastroPendenteValido()) e nascer 'ativo', sem motivo de perda nem desligamento. Sem isso,
    // depois de confirmar o e-mail a pessoa poderia gravar no perfil qualquer carga horária,
    // data de admissão ou status — campos que alimentam a elegibilidade e o peso no Fundo, e que
    // ela não consegue editar depois.
    function perfilConfereComPendente(uid) {
      let p = cadastroPendente(uid);
      let d = request.resource.data;
      return d.nome == p.nome
        && d.email == p.email
        && d.cargaHoraria == p.cargaHoraria
        && d.get('cargo', null) == p.get('cargo', null)
        && d.get('dataAdmissao', null) == p.get('dataAdmissao', null)
        && d.get('fotoBase64', null) == p.get('fotoBase64', null)
        && d.get('criadoPor', null) == p.get('criadoPor', null)
        && d.status == 'ativo'
        && d.get('motivoPerdaIntegral', null) == null
        && d.get('dataDesligamento', null) == null;
    }

    // Schema de cadastrosPendentes/{uid}: mesmos campos que o perfil terá, sem role/status (esses
    // só são atribuídos na promoção para usuarios/{uid}, e sempre como 'colaborador'/'ativo').
    function cadastroPendenteValido() {
      return request.resource.data.keys().hasAll(['nome', 'email', 'cargo', 'cargaHoraria', 'dataAdmissao'])
        && request.resource.data.keys().hasOnly([
             'nome', 'email', 'cargo', 'cargaHoraria', 'dataAdmissao', 'fotoBase64', 'criadoEm', 'criadoPor'
           ])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 120
        && request.resource.data.cargo is string && request.resource.data.cargo.size() > 0 && request.resource.data.cargo.size() <= 80
        && request.resource.data.cargaHoraria in [4, 6, 8]
        && request.resource.data.dataAdmissao is string && request.resource.data.dataAdmissao.size() == 10
        && (request.resource.data.get('fotoBase64', null) == null
            || (request.resource.data.fotoBase64 is string && request.resource.data.fotoBase64.size() <= 150000));
    }

    // -------------------------------------------------------------
    // usuarios/{uid} — perfil de cada colaborador (nunca contém senha)
    //
    // Invariante: este documento só existe para e-mails JÁ CONFIRMADOS. O cadastro (autocadastro
    // ou "Novo colaborador" do Admin) grava primeiro em cadastrosPendentes/{uid}; o próprio
    // colaborador cria o usuarios/{uid} no primeiro login, depois de clicar no link do e-mail
    // (ver promoverCadastroPendente() em auth.js). Como as regras não enxergam o estado de
    // verificação de OUTRA conta, ninguém (nem Admin) cria o usuarios/{uid} de terceiros.
    // -------------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if emailVerificado() && (request.auth.uid == uid || ehDpRhAdmin());

      // O novo registro só pode nascer como 'colaborador', com e-mail @shinerio.com CONFIRMADO
      // (restrição aplicada no token do servidor, não só no formulário), igual ao e-mail da
      // conta e idêntico ao cadastro pendente (perfilConfereComPendente, inclusive o criadoPor).
      // hasOnly() fecha o schema aos campos que o fluxo realmente grava (promoverCadastroPendente
      // em auth.js) — sem isso, o SDK client aceitava qualquer campo extra no create (mass
      // assignment), mesmo que a UI nunca ofereça essa opção.
      allow create: if emailVerificado() && emailInstitucional()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/cadastrosPendentes/$(uid))
        && perfilConfereComPendente(uid)
        && request.resource.data.role == 'colaborador'
        && request.resource.data.keys().hasAll(['nome', 'email', 'cargaHoraria', 'status'])
        && request.resource.data.keys().hasOnly([
             'nome', 'email', 'cargo', 'cargaHoraria', 'status', 'role',
             'fotoBase64', 'motivoPerdaIntegral', 'dataAdmissao', 'dataDesligamento',
             'criadoEm', 'criadoPor'
           ]);

      // O próprio usuário só edita nome/foto. Só Admin/Presidente editam o perfil completo de
      // outros colaboradores — e ninguém, nem Admin, consegue se autopromover a 'presidente'
      // por aqui: só uma sessão já-presidente pode conceder esse papel (na prática, só existe
      // via scripts/seed-usuarios.js). RH tem uma exceção estreita: pode gravar direto (sem
      // aprovação do Presidente) só os 3 campos de "Alterar status do colaborador"
      // (desligamento/afastamento) — nada além disso, dado interno de RH.
      allow update: if emailVerificado() && (
        (request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'fotoBase64'])) ||
        (ehAdminOuPresidente() &&
          (request.resource.data.role != 'presidente' || ehPresidente())) ||
        (papel() == 'rh' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'motivoPerdaIntegral', 'dataDesligamento']))
      );

      allow delete: if emailVerificado() && ehAdminOuPresidente();
    }

    // -------------------------------------------------------------
    // cadastrosPendentes/{uid} — área de espera do cadastro, ANTES da confirmação do e-mail.
    // Nada no painel/fundo/diretório/contratos lê esta coleção — é por isso que um cadastro com
    // e-mail inexistente nunca aparece como colaborador. Dois jeitos de nascer:
    //  (a) autocadastro (Worker/cadastro.html): o dono, ainda com e-mail NÃO confirmado, grava o
    //      próprio doc logo após criar a conta. Só enquanto NÃO confirmado: uma conta já
    //      verificada (ex.: colaborador excluído pelo Admin, cuja conta de Auth continua existindo)
    //      não pode recriar o próprio cadastro para se re-promover — só um Admin/Presidente
    //      (caso b) readmite alguém;
    //  (b) "Novo colaborador" do painel: Admin/Presidente (verificados) gravam em nome da pessoa
    //      convidada, registrando criadoPor.
    // Depois do link do e-mail, o dono lê este doc e cria o usuarios/{uid} (ver regras acima).
    // -------------------------------------------------------------
    match /cadastrosPendentes/{uid} {
      allow create: if cadastroPendenteValido()
        && request.resource.data.email.matches('.*@shinerio[.]com$')
        && (
          (request.auth.uid == uid && emailInstitucional() && !emailVerificado()
            && request.resource.data.email == request.auth.token.email
            && !('criadoPor' in request.resource.data))
          ||
          (emailVerificado() && ehAdminOuPresidente()
            && request.resource.data.criadoPor == request.auth.uid)
        );
      allow read, delete: if emailVerificado() && (request.auth.uid == uid || ehAdminOuPresidente());
      allow update: if false;
    }

    // -------------------------------------------------------------
    // contratos/{id} — ativação/encerramento simples por colaborador. Dado interno de RH
    // (não é a Seção 2 do regulamento, não alimenta o Fundo Shinatal — só a aba "Contratos"
    // empresariais faz isso) — por isso grava direto, sem passar pela fila de solicitações.
    // -------------------------------------------------------------
    match /contratos/{id} {
      allow read: if emailVerificado() && (ehDpRhAdmin() || resource.data.uid == request.auth.uid);
      allow create, update: if emailVerificado() && podeGerenciarContratoColaborador();
      allow delete: if emailVerificado() && ehAdminOuPresidente();
    }

    // -------------------------------------------------------------
    // contratosEmpresariais/{id} — Contratos com empresas-cliente, por CNPJ. Leitura liberada
    // a DP/RH/Admin/Presidente (o card "Status de contratos" de todo Painel depende disso);
    // toda ESCRITA (criar, editar prazo/status, entradas/saídas, excluir) só pelo Presidente —
    // é a mesma fila de solicitações da seção acima, mesmo para o Admin.
    // -------------------------------------------------------------
    match /contratosEmpresariais/{id} {
      allow read: if emailVerificado() && ehDpRhAdmin();
      allow create, update, delete: if emailVerificado() && ehPresidente();
    }

    // -------------------------------------------------------------
    // faltas/{id} e atrasos/{id} — Seções 7 e 8. DP/Admin/Presidente lançam e também podem
    // apagar um lançamento feito por engano.
    // -------------------------------------------------------------
    match /faltas/{id} {
      allow read: if emailVerificado() && (ehDpRhAdmin() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if emailVerificado() && ehDp();
    }
    match /atrasos/{id} {
      allow read: if emailVerificado() && (ehDpRhAdmin() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if emailVerificado() && ehDp();
    }

    // -------------------------------------------------------------
    // advertencias/{id} — Seção 9. Agora é o DP quem lança (antes era RH), e pode apagar por
    // engano. RH não participa mais deste tópico.
    // -------------------------------------------------------------
    match /advertencias/{id} {
      allow read: if emailVerificado() && (ehDpRhAdmin() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if emailVerificado() && ehDp();
    }

    // -------------------------------------------------------------
    // avaliacoes/{id} — Seção 11. Criar/editar passa pela fila de solicitações — só o
    // Presidente grava de verdade. Apagar um lançamento já existente (por engano) continua
    // liberado a quem participa do tópico (DP e RH), sem precisar de aprovação — é uma
    // correção, não uma decisão de negócio nova.
    // -------------------------------------------------------------
    match /avaliacoes/{id} {
      allow read: if emailVerificado() && (ehDpRhAdmin() || resource.data.uid == request.auth.uid);
      allow create, update: if emailVerificado() && ehPresidente();
      allow delete: if emailVerificado() && podeAvaliar();
    }

    // -------------------------------------------------------------
    // solicitacoes/{id} — fila de aprovação do Presidente para contratos e avaliações.
    // Qualquer gestor (DP/RH/Admin) cria um pedido pendente; só o Presidente lê a fila
    // completa e só ele pode aceitar/rejeitar (mudar de "pendente" para outro status) — o
    // solicitante também pode ler o próprio pedido, para acompanhar o status. Imutável depois
    // de resolvido (nada além do próprio Presidente muda "pendente" -> "aceita"/"rejeitada").
    // -------------------------------------------------------------
    match /solicitacoes/{id} {
      allow read: if emailVerificado() && (ehPresidente() || resource.data.solicitadoPorUid == request.auth.uid);
      allow create: if emailVerificado() && papel() in ['dp', 'rh', 'admin']
        && request.resource.data.status == 'pendente'
        && request.resource.data.solicitadoPorUid == request.auth.uid;
      allow update: if emailVerificado() && ehPresidente()
        && resource.data.status == 'pendente'
        && request.resource.data.status in ['aceita', 'rejeitada'];
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // fundo/{ano} — agregado público (saldo do fundo, soma de pesos).
    // Lido por todos os colaboradores autenticados; DP/RH/Admin/Presidente recalculam (é um
    // republicar de dados já protegidos acima, não uma decisão de negócio nova).
    // -------------------------------------------------------------
    match /fundo/{ano} {
      allow read: if emailVerificado();
      allow write: if emailVerificado() && ehDpRhAdmin();
    }

    // -------------------------------------------------------------
    // estatisticas/publico — agregado público (só os 2 números da landing page,
    // sem login: valor arrecadado e quantidade de colaboradores). Nunca contém
    // PII — para isso, use sempre a coleção `usuarios`, que já é protegida acima.
    // -------------------------------------------------------------
    match /estatisticas/publico {
      allow read: if true;
      allow write: if emailVerificado() && ehDpRhAdmin();
    }

    // -------------------------------------------------------------
    // logs/{id} — log de auditoria das ações de DP/RH/Admin/Presidente (faltas, atrasos,
    // advertências, avaliações, papel, criação/exclusão de colaborador — NÃO inclui histórico
    // de contratos, que já tem o seu próprio em contratosEmpresariais.historicoMovimentacoes,
    // nem a fila de solicitações, que já é seu próprio registro auditável). Só Admin/Presidente
    // leem. Nunca é editável (falsificaria a trilha) — só Admin/Presidente podem excluir, para
    // limpar o log quando quiserem (com confirmação na interface).
    // -------------------------------------------------------------
    match /logs/{id} {
      allow read: if emailVerificado() && ehAdminOuPresidente();
      allow create: if emailVerificado() && ehDpRhAdmin();
      allow update: if false;
      allow delete: if emailVerificado() && ehAdminOuPresidente();
    }

    // -------------------------------------------------------------
    // Avaliação de Conduta (entre colegas) — feature social/anônima, TOTALMENTE separada de
    // avaliacoes/{id} (Seção 11) e nunca lida por calculo-shinatal.js: não afeta cota nem fundo.
    // Presidente nunca participa (nem como avaliador, nem como avaliado). Votos são anônimos:
    // só o autor de um voto consegue lê-lo — nem o avaliado, nem Admin/Presidente conseguem
    // ver quem votou o quê, só a contagem agregada.
    // -------------------------------------------------------------

    // Interruptor global — só Admin/Presidente ligam/desligam a função para todo mundo.
    match /configuracoes/avaliacaoConduta {
      allow read: if emailVerificado();
      allow write: if emailVerificado() && ehAdminOuPresidente()
        && request.resource.data.keys().hasOnly(['ativo', 'atualizadoEm', 'atualizadoPor']);
    }

    // Diretório mínimo (nome/cargo/role) usado só para montar a lista de colaboradores avaliáveis
    // no lado do colaborador comum — existe para NÃO precisar expandir a leitura de usuarios/{uid}
    // (que tem e-mail, carga horária, motivo de desligamento etc.) para todo mundo. Cada um
    // sincroniza o próprio doc ao logar; Admin/Presidente também sincronizam em nome de qualquer
    // colaborador (ao criar/editar/trocar o papel de alguém, pelo painel de gestão), pra o
    // diretório já nascer completo, sem depender daquele colaborador logar primeiro. Sempre
    // validado contra o usuarios/{uid} real — nunca aceita um valor inventado pelo cliente.
    match /diretorioPublico/{uid} {
      allow read: if emailVerificado();
      allow write: if emailVerificado() && (request.auth.uid == uid || ehAdminOuPresidente())
        && request.resource.data.keys().hasOnly(['nome', 'cargo', 'role'])
        && request.resource.data.role != 'presidente'
        && request.resource.data.role == get(/databases/$(database)/documents/usuarios/$(uid)).data.role
        && request.resource.data.nome == get(/databases/$(database)/documents/usuarios/$(uid)).data.nome
        && request.resource.data.cargo == get(/databases/$(database)/documents/usuarios/$(uid)).data.cargo;
      allow delete: if emailVerificado() && (request.auth.uid == uid || ehAdminOuPresidente());
    }

    // Voto individual (1 por par avaliador→avaliado, id determinístico). Só o autor lê o
    // próprio voto — é essa regra, e não só a UI, que garante o anonimato.
    match /votosConduta/{votoId} {
      // `resource == null ||` primeiro: a transação de votarConduta() sempre faz um tx.get()
      // no próprio voto ANTES de criá-lo (pra saber se está criando ou editando), e nesse
      // primeiro voto o documento ainda não existe — sem esse curto-circuito, acessar
      // `resource.data` num documento inexistente é erro de avaliação, e a regra nega a leitura
      // (não só devolve "não encontrado"), o que travava TODO primeiro voto de todo mundo.
      allow read: if emailVerificado() && (resource == null || resource.data.avaliadorUid == request.auth.uid);
      allow create, update: if emailVerificado()
        && avaliacaoCondutaAtiva() && podeParticiparConduta()
        && request.resource.data.avaliadorUid == request.auth.uid
        && request.resource.data.avaliadoUid != request.auth.uid
        && !ehPresidenteUid(request.resource.data.avaliadoUid)
        && votoId == request.resource.data.avaliadorUid + '_' + request.resource.data.avaliadoUid
        && request.resource.data.conceito in ['excelente', 'bom', 'regular', 'insatisfatorio']
        && request.resource.data.keys().hasOnly(['avaliadorUid', 'avaliadoUid', 'conceito', 'criadoEm', 'atualizadoEm']);
      allow delete: if false;
    }

    // Contagem agregada e anônima por pessoa avaliada — o que aparece no perfil. Leitura no
    // mesmo escopo de quem já pode ver o perfil detalhado de alguém (PODE_VER_PERFIL() no
    // front-end = ehDpRhAdmin() aqui). Escrita feita numa transação client-side junto com o
    // voto individual (ver conduta-service.js) — as regras não conseguem correlacionar as duas
    // escritas da mesma transação, então cada campo é limitado a mudar no máximo 1 voto por
    // escrita (mesmo nível de rigor pragmático já usado no resto deste arquivo, ex.: avaliacoes
    // não tem hasOnly()).
    match /condutaContagem/{avaliadoUid} {
      allow read: if emailVerificado() && (avaliadoUid == request.auth.uid || ehDpRhAdmin());

      allow create: if emailVerificado() && avaliacaoCondutaAtiva() && podeParticiparConduta()
        && avaliadoUid != request.auth.uid && !ehPresidenteUid(avaliadoUid)
        && request.resource.data.keys().hasOnly(['excelente', 'bom', 'regular', 'insatisfatorio', 'atualizadoEm'])
        && request.resource.data.excelente + request.resource.data.bom
           + request.resource.data.regular + request.resource.data.insatisfatorio == 1;

      allow update: if emailVerificado() && avaliacaoCondutaAtiva() && podeParticiparConduta()
        && avaliadoUid != request.auth.uid && !ehPresidenteUid(avaliadoUid)
        && request.resource.data.keys().hasOnly(['excelente', 'bom', 'regular', 'insatisfatorio', 'atualizadoEm'])
        // Cada campo só pode mudar em no máximo 1 voto por escrita, e a soma total nunca cai —
        // só sobe 0 ou 1 — cobre tanto "voto novo" (+1 num campo) quanto "trocar de conceito"
        // (-1 num campo, +1 em outro, soma igual).
        && request.resource.data.excelente - resource.data.excelente >= -1 && request.resource.data.excelente - resource.data.excelente <= 1
        && request.resource.data.bom - resource.data.bom >= -1 && request.resource.data.bom - resource.data.bom <= 1
        && request.resource.data.regular - resource.data.regular >= -1 && request.resource.data.regular - resource.data.regular <= 1
        && request.resource.data.insatisfatorio - resource.data.insatisfatorio >= -1 && request.resource.data.insatisfatorio - resource.data.insatisfatorio <= 1
        && (request.resource.data.excelente + request.resource.data.bom + request.resource.data.regular + request.resource.data.insatisfatorio)
           >= (resource.data.excelente + resource.data.bom + resource.data.regular + resource.data.insatisfatorio)
        && (request.resource.data.excelente + request.resource.data.bom + request.resource.data.regular + request.resource.data.insatisfatorio)
           <= (resource.data.excelente + resource.data.bom + resource.data.regular + resource.data.insatisfatorio) + 1;

      allow delete: if false;
    }
  }
}
